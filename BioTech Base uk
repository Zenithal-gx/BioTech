    def find_orfs(self):
        if not self.current_seq: return self.log("[!] Спочатку завантажте FASTA.")
        self.log("\n[ORF] Пошук білків...")
        translated = self.current_seq.translate()
        proteins = [p for p in translated.split("*") if len(p) >= 100 and "M" in p]
        if not proteins: return self.log("  Білкiв довших за 100 а/к не знайдено.")
        for i, p in enumerate(proteins[:3]):
            valid_p = p[p.find("M"):]
            analysis = ProteinAnalysis(str(valid_p))
            self.log(f"  ORF #{i+1} | Довжина {len(valid_p)} а/к | MW: {analysis.molecular_weight():.1f} Da")

    def map_restriction(self):
        if not self.current_seq: return self.log("[!] Спочатку завантажте FASTA.")
        enzymes = [e.strip() for e in self.ent_enz.get().split(",")]
        try:
            batch = RestrictionBatch(enzymes)
            res = batch.search(self.current_seq)
            self.log("\n[Рестрикція]")
            for enz, sites in res.items():
                self.log(f"  {enz}: {len(sites)} сайтів -> {sites}")
        except Exception as e:
            self.log(f"[Помилка] {e}")

    def analyze_primer(self):
        p = self.ent_prim.get().strip().upper()
        if not p: return
        tm = mt.Tm_NN(p)
        self.log(f"\n[Праймер] {p}\n  Температура плавлення (Tm): {tm:.1f} °C")

