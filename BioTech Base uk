        ent.grid(row=row_num, column=1, padx=10, pady=5)
        if default_val:
            ent.insert(0, default_val)
        return ent

    def calc_c1v1(self):
        vals = [self.ent_c1.get(), self.ent_v1.get(), self.ent_c2.get(), self.ent_v2.get()]
        empty_count = sum(1 for v in vals if v.strip() == "")
        
        if empty_count != 1:
            return self.log("[Помилка C1V1] Залиште рівно ОДНЕ поле порожнім для розрахунку.")
            
        try:
            if not vals[0]: # Шукаємо C1
                res = (float(vals[2]) * float(vals[3])) / float(vals[1])
                self.log(f"[C1V1] Початкова концентрація C₁ = {res:.4f}")
            elif not vals[1]: # Шукаємо V1
                res = (float(vals[2]) * float(vals[3])) / float(vals[0])
                self.log(f"[C1V1] Потрібно взяти {res:.2f} одиниць об'єму початкового розчину (V₁)")
                if float(vals[3]) - res > 0:
                    self.log(f"       І додати {float(vals[3]) - res:.2f} одиниць розчинника (води).")
            elif not vals[2]: # Шукаємо C2
                res = (float(vals[0]) * float(vals[1])) / float(vals[3])
                self.log(f"[C1V1] Кінцева концентрація C₂ = {res:.4f}")
            elif not vals[3]: # Шукаємо V2
                res = (float(vals[0]) * float(vals[1])) / float(vals[2])
                self.log(f"[C1V1] Кінцевий об'єм V₂ = {res:.2f}")
        except ValueError:
            self.log("[Помилка] Вводьте лише числа.")

    def calc_ph(self):
        try:
            ph = float(self.ent_ph.get())
            pka = float(self.ent_pka.get())
            c_tot = float(self.ent_c_total.get())
            
            ratio = 10**(ph - pka)
            acid = c_tot / (ratio + 1)
            salt = c_tot - acid
            
            self.log(f"\n[Буфер] Для досягнення pH {ph} (pKa {pka}):")
            self.log(f"  Співвідношення [Сіль]/[Кислота] = {ratio:.3f}")
            self.log(f"  Концентрація кислоти: {acid:.4f} М")
            self.log(f"  Концентрація солі: {salt:.4f} М")
        except ValueError:
            self.log("[Помилка] Перевірте правильність введених чисел.")

    def calc_spec(self):
        try:
            a = float(self.ent_abs.get())
            eps = float(self.ent_eps.get())
            l = float(self.ent_l.get())
            
            c = a / (eps * l)
            self.log(f"\n[Спектрофотометрія] A = {a}, ε = {eps}, l = {l} см")
            self.log(f"  Концентрація речовини (c): {c:.6e} М (Моль/літр)")
        except ValueError:
            self.log("[Помилка] Перевірте введення. Можна використовувати формат 1e-6.")

