    def load_fasta(self):
        path = filedialog.askopenfilename(filetypes=[("FASTA", "*.fasta *.fa *.fna")])
        if path:
            try:
                record = next(SeqIO.parse(path, "fasta"))
                self.current_seq = record.seq
                self.current_seq_id = record.id
                self.status_lbl.configure(text=f"{self.current_seq_id[:15]}...\nДовжина: {len(self.current_seq)}")
                self.log(f"[FASTA] Успішно завантажено: {self.current_seq_id}")
            except Exception as e:
                self.log(f"[Помилка] Читання FASTA: {e}")

